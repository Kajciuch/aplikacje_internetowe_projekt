# Skopiuj ten plik jako ".env" i uzupełnij własnymi wartościami.

# --- Konfiguracja podstawowa ----------------------------------------------
FLASK_ENV=development
SECRET_KEY=zmien-na-dlugi-losowy-ciag-bajtow

# Ścieżka do pliku bazy SQLite (domyślnie obok app.py)
DATABASE=praktyki.db

# --- Logowanie przez Microsoft (OAuth2) ----------------------------------
# Pozostaw puste, aby wyłączyć logowanie Microsoft (działa logowanie e-mail+hasło).
# Aby włączyć: zarejestruj aplikację w Azure Portal:
#   1) https://portal.azure.com → Azure Active Directory → App registrations → New registration
#   2) Nazwa: "System Praktyk", typ kont: "Accounts in any organizational directory"
#   3) Redirect URI (Web): http://localhost:5000/auth/microsoft/callback
#   4) Zapisz Application (client) ID i Directory (tenant) ID
#   5) Certificates & secrets → New client secret → skopiuj wartość
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback
